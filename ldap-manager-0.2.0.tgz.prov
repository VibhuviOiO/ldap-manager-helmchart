annotations:
  artifacthub.io/category: security
  artifacthub.io/changes: |
    - kind: added
      description: Initial chart - Deployment, config.yml ConfigMap, Secret wiring, PVCs for /app/.data and /app/.secrets
    - kind: added
      description: Ingress, startup/readiness/liveness probes on the app-local endpoint, and a hardened securityContext
    - kind: added
      description: PodDisruptionBudget, plus a render-time guard that refuses replicaCount > 1 against ReadWriteOnce state volumes
